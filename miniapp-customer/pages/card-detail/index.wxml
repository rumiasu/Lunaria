<view class="page"><view class="title">这张护理卡</view><view wx:if="{{loading}}" class="empty">正在加载…</view><view wx:if="{{error}}" class="error">{{error}}<button class="secondary" bindtap="retry">重试</button></view><view wx:if="{{card}}"><view class="card"><view class="heading">{{card.name}}</view><view class="tag">{{card.statusText}}</view><view class="amount">{{card.remaining}} / {{card.total}} 次</view><view>实付 ¥{{card.paidText}} · 已用 {{card.used}} 次</view><view class="rule">{{card.rule_snapshot}}</view></view><view class="heading section">使用记录</view><view wx:if="{{!ledger.length}}" class="empty">暂无流水。</view><view wx:for="{{ledger}}" wx:key="id" class="card"><view class="row"><view>{{item.kindText}}</view><view>¥{{item.amountText}}</view></view><view class="small muted">{{item.note}}</view></view><view wx:if="{{card.status==='ACTIVE'}}" class="card"><view class="heading">退卡申请</view><view class="rule">按实付金额分摊已用次数。仅做试算与人工登记；原因有争议时保留处理，不自动少退。余额购卡退回原余额。</view><picker range="{{reasons}}" value="{{reasonIndex}}" bindchange="reasonChange">{{reasons[reasonIndex]}}</picker><textarea class="field" data-field="evidence" bindinput="input" value="{{evidence}}" maxlength="500" placeholder="退款原因及约定、证据说明"/><button class="secondary" bindtap="trial" disabled="{{busy}}">试算退款本金</button><view wx:if="{{quote}}"><view class="amount">¥ {{quote.amountText}}</view><view class="muted">{{quote.notice}}</view><button bindtap="refund" disabled="{{busy}}" loading="{{busy}}">提交人工处理</button></view></view><view wx:for="{{refunds}}" wx:key="id" class="card"><view>{{item.reasonText}} · {{item.statusText}}</view><view>申请本金 ¥{{item.amountText}}</view><view class="muted">{{item.review_note}}</view></view></view></view>
