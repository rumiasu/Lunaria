/* Functional wireframe tokens. Brand art, typography and final palette await design discussion. */
page{--paper:#f6f4f0;--surface:#ffffff;--ink:#252f2b;--muted:#59655e;--accent:#385b4e;--line:#d8dfd8;--danger:#a53138;--radius:22rpx;background:var(--paper);color:var(--ink);font-size:30rpx;line-height:1.6;font-family:system-ui,-apple-system,sans-serif}
.page{padding:32rpx 30rpx 60rpx}.eyebrow{font-size:24rpx;letter-spacing:5rpx;color:var(--accent)}.title{font-size:48rpx;font-weight:600;line-height:1.3;margin:10rpx 0 18rpx}.subtitle,.muted{color:var(--muted);font-size:27rpx}.demo{font-size:24rpx;background:#e6ece6;padding:16rpx 22rpx;border-radius:var(--radius);margin-bottom:28rpx}.card{background:var(--surface);padding:28rpx;border:1rpx solid var(--line);border-radius:var(--radius);margin:22rpx 0}.heading{font-size:34rpx;font-weight:600}.row{display:flex;justify-content:space-between;align-items:center;gap:18rpx}.wrap{flex-wrap:wrap}.stack{display:flex;flex-direction:column;gap:16rpx}.amount{font-size:46rpx;font-weight:600}.tag{display:inline-block;font-size:24rpx;color:var(--accent);background:#eaf0eb;border-radius:12rpx;padding:3rpx 14rpx}.label{font-size:27rpx;margin:20rpx 0 8rpx}.empty{padding:40rpx 20rpx;text-align:center;color:var(--muted)}.error{color:#85212a;background:#fceeee;border:1rpx solid #e8bcbc;padding:20rpx;border-radius:14rpx;margin:20rpx 0}.rule{border-left:6rpx solid var(--accent);padding-left:18rpx;margin:22rpx 0;font-size:26rpx;color:var(--muted)}button{font-size:30rpx;border-radius:16rpx;min-height:92rpx;line-height:92rpx;margin:16rpx 0;background:var(--accent);color:#fff;font-weight:500}button::after{border:0}button.secondary{background:#edf0eb;color:var(--ink);border:1rpx solid var(--line)}button.danger{background:#fff0ef;color:var(--danger);border:1rpx solid #e9c1bd}button[disabled]{background:#d9dfda;color:#535e56}.actions{display:flex;gap:18rpx;flex-wrap:wrap}.actions button{flex:1;min-width:220rpx}.field,picker{box-sizing:border-box;background:#fff;border:1rpx solid var(--line);border-radius:14rpx;min-height:92rpx;padding:22rpx;color:var(--ink);margin:10rpx 0}input.field{height:100rpx}textarea.field{width:100%;height:160rpx}.divider{height:1rpx;background:var(--line);margin:24rpx 0}.small{font-size:24rpx}.section{margin-top:36rpx}.pill{padding:18rpx 24rpx;border:1rpx solid var(--line);border-radius:14rpx;min-width:132rpx;text-align:center;background:#fff}.pill.selected{background:var(--accent);color:#fff}.grid{display:flex;flex-wrap:wrap;gap:16rpx;margin:20rpx 0}
