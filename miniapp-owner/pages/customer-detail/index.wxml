<view class="page"><view class="title">顾客记录</view><view wx:if="{{loading}}" class="empty">正在加载…</view><view wx:if="{{error}}" class="error">{{error}}<button class="secondary" bindtap="retry">重试</button></view><view wx:if="{{customer}}"><view class="card"><view class="heading">{{customer.name}}</view><view class="amount">¥ {{customer.balanceText}}</view><view class="muted">本金余额 · {{customer.tier}}</view></view><view class="heading section">套餐卡</view><view wx:for="{{cards}}" wx:key="id" class="card"><view>{{item.name}} · {{item.statusText}}</view><view>余 {{item.remaining}} / {{item.total}} 次 · 实付 ¥{{item.paidText}}</view><view class="small muted">{{item.rule_snapshot}}</view></view><view class="card"><view class="heading">本金充值登记</view><view class="rule">仅演示记账。无赠送金，不代表在线支付成功。</view><input class="field" type="digit" data-field="amount" value="{{amount}}" bindinput="input" placeholder="本金金额（元）"/><input class="field" data-field="reference" value="{{reference}}" maxlength="250" bindinput="input" placeholder="来源或演示收款凭据编号"/><button bindtap="recharge" disabled="{{busy}}" loading="{{busy}}">登记本金</button></view><view class="heading section">预约记录</view><view wx:for="{{appointments}}" wx:key="id" class="card">{{item.timeText}} · {{item.service_name}} · {{item.statusText}}</view><view class="heading section">可追溯流水</view><view wx:for="{{ledger}}" wx:key="id" class="card"><view class="row"><view>{{item.kindText}}</view><view>¥ {{item.amountText}}</view></view><view class="small muted">来源：{{item.source_id}}</view><view class="small muted">{{item.note}}</view><button wx:if="{{item.kind==='SERVICE'}}" class="secondary" data-id="{{item.id}}" bindtap="reverse" disabled="{{busy}}">纠错冲正 · 留痕</button></view></view></view>
