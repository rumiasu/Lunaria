<view class="page"><view class="demo">店长专用 · 独立演示 · 微信身份与通知未接入</view><view class="eyebrow">LUNARIA / STUDIO</view><view class="title">今天，安心照顾每一位</view><view class="subtitle">{{today}} · 今日未完成预约 {{count}} 笔</view><view wx:if="{{!ready}}" class="card"><view class="heading">进入店长开发账户</view><view class="muted">当前仅本机模拟店长，正式环境禁止此入口。</view><button data-user="owner" bindtap="demoLogin" loading="{{busy}}">店长演示登录</button></view><view wx:if="{{loading}}" class="empty">正在加载待办…</view><view wx:if="{{error}}" class="error">{{error}}<button class="secondary" bindtap="retry">重新加载</button></view><view wx:if="{{ready}}"><view class="heading section">待确认与后续预约</view><view wx:if="{{!appointments.length}}" class="empty">当前没有待办预约。</view><view wx:for="{{appointments}}" wx:key="id" class="card"><view class="row"><view class="heading">{{item.customer_name}}</view><view class="tag">{{item.statusText}}</view></view><view>{{item.timeText}} · {{item.duration}} 分钟</view><view>{{item.service_name}}</view><view class="muted">{{item.note}}</view><view class="actions"><button wx:if="{{item.status==='PENDING'}}" data-id="{{item.id}}" bindtap="confirm" disabled="{{busy}}">确认预约</button><button wx:if="{{item.status==='CONFIRMED'}}" data-id="{{item.id}}" bindtap="complete" disabled="{{busy}}">服务后核销</button><button class="secondary" data-id="{{item.id}}" bindtap="move" disabled="{{busy}}">调整时间</button><button class="danger" data-id="{{item.id}}" bindtap="cancel" disabled="{{busy}}">取消并留原因</button></view></view></view></view>
